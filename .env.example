# Ei file ta shudhu structure dekhay — kokhono real key ekhane hobe na.
# Real key shudhu .env.local-e thake (jeta git-e jay na), ar
# Vercel-e alada kore Environment Variables-e bosano hoy.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
SUPABASE_SERVICE_ROLE_KEY = secret-service-role-key-here